<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorInk">#16343D</Color>
    <Color x:Key="ColorMuted">#60777E</Color>
    <Color x:Key="ColorAccent">#127C78</Color>
    <Color x:Key="ColorAccentSoft">#E6F3F1</Color>
    <Color x:Key="ColorCanvas">#F4F7F8</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#DCE6E8</Color>
    <Color x:Key="ColorFocus">#E0A72E</Color>

    <SolidColorBrush x:Key="BrushInk" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushCanvas" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushFocus" Color="{StaticResource ColorFocus}" />

    <FontFamily x:Key="FontFamilyLatin">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyBengali">Nirmala UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushInk}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyLatin}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>
</ResourceDictionary>
